{
  "name": "agritrade-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}' 'scripts/**/*.{js,mjs,ts}' next.config.ts vitest.config.ts eslint.config.mjs tsconfig.json package.json '.github/workflows/*.yml'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'test/**/*.{ts,tsx}' 'scripts/**/*.{js,mjs,ts}' next.config.ts vitest.config.ts eslint.config.mjs tsconfig.json package.json '.github/workflows/*.yml'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "audit:ci": "node scripts/audit-gate.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-table": "^8.21.3",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.434.14",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
